# Template for keystore.properties, which signs release builds.
#
# Copy this file to `keystore.properties` (same directory, no `.template`) and fill in the four
# values. This template is committed and holds no secrets; `keystore.properties` is gitignored and
# must never be committed, pasted into an issue, or screenshotted. Without it, release builds are
# produced unsigned.
#
# Fill it in yourself, in an editor, not through an AI coding session: a session that has read or
# written this file sees its new contents when it changes on disk, passwords included.
#
# Creating the keystore, once:
#
#   keytool -genkeypair -v \
#     -keystore ~/.android/stillnote-release.jks \
#     -storetype PKCS12 \
#     -alias stillnote \
#     -keyalg RSA -keysize 2048 \
#     -validity 10000
#
# `keytool` ships with any JDK, including Android Studio's (`jbr/bin/keytool`). Keep the keystore
# outside this repository, and back it up together with its passwords: Android installs an update
# only if it is signed with the same key, so a new key means uninstalling the app (and its data)
# first.

# Absolute path to the keystore. Use forward slashes even on Windows.
storeFile=/home/you/.android/stillnote-release.jks

# The password you gave the keystore.
storePassword=

# The -alias you passed to keytool.
keyAlias=stillnote

# The password for that key; the same as storePassword if you accepted keytool's offer to reuse it.
keyPassword=
